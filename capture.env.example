# Copy to capture.env on the capture host. Read by the systemd unit
# (deploy/mdp3-capture.service). Up to four products, comma-separated.
PRODUCTS=ES,NQ,CL,ZN
# Interface(s) to receive on, comma-separated: loopback for feeds this host sends
# to itself (simulator, replay), plus the LAN address for feeds from other hosts.
IFACE=127.0.0.1
INTERVAL=3
