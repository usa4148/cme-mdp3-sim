# Copy to config.env (chmod 600) and fill in. Read by capture.py, replay.py
# (s3: sources) and s3store.py. Do NOT commit config.env. These are the
# bucket credentials; copy them onto the VM yourself — they are never passed
# on the command line.

AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

# VAST S3 endpoint, e.g. https://10.0.0.60 or https://s3.vast.example:443
S3_ENDPOINT_URL=REPLACE_ME
S3_BUCKET=REPLACE_ME

# Optional
S3_PREFIX=mdp3-pcap
S3_REGION=us-east-1
# Set to false for a self-signed VAST TLS cert
S3_VERIFY_SSL=true
